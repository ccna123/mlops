# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ML_BUCKET=ml-pipeline

# PostgreSQL
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_URI_LOCAL=http://localhost:5000

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Serving (used from Plan 3)
SERVING_URL=http://serving:8000

# Metrics and alerting (Prometheus, Pushgateway, Grafana at http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Where alerts are sent: a Slack or Discord incoming webhook, or any URL taking
# JSON. Leave empty to see alerts in Grafana only.
ALERT_WEBHOOK_URL=
